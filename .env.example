# 复制为 .env 再填。只填你要用的那个，没填的任务不会启用。
# 值不要加引号（PEM 那两行例外：保持一行，换行写成 \n 即可）。

# ===== WorkBuddy =====
WORKBUDDY_REFRESH_TOKEN=
# WORKBUDDY_TIME=00:30

# ===== Trae（国内版）=====
# 下面 5 项都来自电脑上登录着 Trae 的那台机器，见 README「获取令牌」
TRAE_REFRESH_TOKEN=
TRAE_DEVICE_ID=
TRAE_MACHINE_ID=
TRAE_DEVICE_KEY_PEM=
TRAE_DEVICE_PUB_PEM=
# TRAE_TIME=00:23

# ===== 通知（可选）=====
# ntfy 主题地址，例如 https://ntfy.example.com/checkin ；有鉴权再填 NTFY_TOKEN
NTFY_URL=
# NTFY_TOKEN=

# ===== 调度（可选）=====
# RETRY_MIN=30      失败后多少分钟重试
# MAX_TRIES=8       每天最多尝试几次
# CHECKIN_PROXY=    需要走代理时填，如 http://192.168.0.1:7890
