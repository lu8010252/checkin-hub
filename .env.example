# 可选：全部配置都可以在网页后台「设置」里填，这个文件不是必须的。
# 想用的话：在 docker-compose.yml 的 checkin 下加一行 env_file: .env
# 网页里保存的设置优先于这里。

# 网页后台登录密码（建议在 docker-compose.yml 里设置）
# WEB_PASSWORD=

# WorkBuddy
# WORKBUDDY_REFRESH_TOKEN=
# WORKBUDDY_TIME=00:30

# Trae（国内版）5 项
# TRAE_REFRESH_TOKEN=
# TRAE_DEVICE_ID=
# TRAE_MACHINE_ID=
# TRAE_DEVICE_KEY_PEM=
# TRAE_DEVICE_PUB_PEM=
# TRAE_TIME=00:23

# 通知（ntfy）
# NTFY_URL=
# NTFY_TOKEN=

# 调度
# RETRY_MIN=30
# MAX_TRIES=8
# CHECKIN_PROXY=http://192.168.0.1:7890   # 访问两家接口需要代理时填（只能在这里设置，网页里没有）
